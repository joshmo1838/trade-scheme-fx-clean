{
  "name": "trade-scheme-fx",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build-native-deriv-editor.mjs",
    "build": "next build",
    "start": "next start",
    "worker:forward": "node worker/senfx-forward-worker.mjs",
    "typecheck": "tsc --noEmit",
    "test:routes": "node scripts/check-workspace-routes.mjs",
    "test:native-editor": "node --test tests/deriv-native-editor.test.mjs",
    "test:workspace": "node --experimental-strip-types --test tests/workspace-command-palette.test.mjs",
    "test:integration": "node --test tests/workspace-integration.test.mjs",
    "test:operations": "node --experimental-strip-types --test tests/workspace-paper-operations.test.mjs",
    "test:engine": "node --experimental-strip-types --test tests/paper-strategy.test.mjs",
    "test:controls": "node --experimental-strip-types --test tests/bot-control.test.mjs",
    "worker:paper": "node --experimental-strip-types worker/senfx-customer-paper-worker.mjs",
    "test:paper-worker": "node --experimental-strip-types --test tests/paper-worker.test.mjs tests/paper-reconcile.test.mjs",
    "test:worker-e2e": "node --experimental-strip-types --test tests/offline-worker/worker-e2e.test.mjs",
    "test:auth-controls": "node --experimental-strip-types --experimental-loader ./tests/auth-control/loader.mjs --test tests/auth-control/api.test.mjs",
    "test:deriv-login-guard": "node --experimental-strip-types --test tests/deriv-first-login-identity-guard.test.mjs tests/deriv-nickname-identity-parser.test.mjs tests/deriv-first-login-release-gate.test.mjs tests/deriv-first-login-userinfo.test.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.90.0",
    "next": "16.4.6",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.2.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": "24.x"
  }
}
