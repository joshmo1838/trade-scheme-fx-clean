# Isolated SENFX Deriv virtual-Demo-only 15-bot worker.
# Default-OFF; requires independent feature flags, admin OAuth and a DB Stop/Start lease.
# Never includes Vercel credentials in build context or image.
FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /opt/senfx
COPY worker/package.json ./worker/package.json
RUN cd worker && npm install --omit=dev --ignore-scripts --no-audit --no-fund
COPY worker/senfx-deriv-demo-15bot-worker.mjs ./worker/senfx-deriv-demo-15bot-worker.mjs
COPY worker/senfx-deriv-demo-15bot-readiness.mjs ./worker/senfx-deriv-demo-15bot-readiness.mjs
COPY lib/bots/fifteen-paper-bots.ts ./lib/bots/fifteen-paper-bots.ts
COPY lib/bots/digit-matrix.ts ./lib/bots/digit-matrix.ts
COPY lib/deriv/demo-bot-contracts.mjs ./lib/deriv/demo-bot-contracts.mjs
COPY lib/deriv/demo-15bot-worker-safety.mjs ./lib/deriv/demo-15bot-worker-safety.mjs
COPY lib/deriv/demo-ten-x-profit-gate.mjs ./lib/deriv/demo-ten-x-profit-gate.mjs
USER node
WORKDIR /opt/senfx/worker
CMD ["node", "--experimental-strip-types", "senfx-deriv-demo-15bot-worker.mjs"]
