# SEPARATE, DEFAULT-OFF, DERIV PUBLIC TICK RESEARCH — NEVER broker execution.
FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /opt/senfx
COPY worker/golden-rule/package.json ./package.json
RUN npm install --omit=dev --ignore-scripts --no-audit --no-fund
COPY worker/senfx-golden-rule-15m-worker.mjs ./worker/senfx-golden-rule-15m-worker.mjs
COPY lib/bots/fifteen-paper-bots.ts ./lib/bots/fifteen-paper-bots.ts
COPY lib/bots/digit-matrix.ts ./lib/bots/digit-matrix.ts
COPY lib/bots/senfx-golden-rule-research.ts ./lib/bots/senfx-golden-rule-research.ts
COPY lib/bots/senfx-golden-rule.mjs ./lib/bots/senfx-golden-rule.mjs
USER node
CMD ["node","--experimental-strip-types","worker/senfx-golden-rule-15m-worker.mjs"]
