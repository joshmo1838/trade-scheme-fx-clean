
import { NextResponse } from "next/server";
import { createClient } from "@/lib/supabase/server";
import { createClient as createSupabaseAdmin } from "@supabase/supabase-js";
import { createDecipheriv } from "node:crypto";

export const dynamic = "force-dynamic";

function decryptToken(
  ciphertext: string,
  iv: string,
  tag: string
) {
  const keyHex = process.env.DERIV_TOKEN_ENCRYPTION_KEY;

  if (!keyHex || !/^[a-f0-9]{64}$/i.test(keyHex)) {
    throw new Error("Encryption configuration is invalid");
  }

  const decipher = createDecipheriv(
    "aes-256-gcm",
    Buffer.from(keyHex, "hex"),
    Buffer.from(iv, "base64")
  );

  decipher.setAuthTag(Buffer.from(tag, "base64"));

  return Buffer.concat([
    decipher.update(Buffer.from(ciphertext, "base64")),
    decipher.final()
  ]).toString("utf8");
}

export async function GET() {
  try {
    // Verify the signed-in website customer.
    const supabase = await createClient();

    const {
      data: { user },
      error: authError
    } = await supabase.auth.getUser();

    if (authError || !user) {
      return NextResponse.json(
        { error: "Please sign in." },
        { status: 401 }
      );
    }

    const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL;
    const serviceKey = process.env.SUPABASE_SERVICE_ROLE_KEY;

    if (!supabaseUrl || !serviceKey) {
      return NextResponse.json(
        { error: "Server configuration is incomplete." },
        { status: 500 }
      );
    }

    // Read only this customer's encrypted Deriv connection.
    const admin = createSupabaseAdmin(
      supabaseUrl,
      serviceKey,
      {
        auth: {
          autoRefreshToken: false,
          persistSession: false
        }
      }
    );

    const { data: connection, error: dbError } = await admin
      .from("deriv_connections")
      .select(
        "encrypted_token, token_iv, token_tag, expires_at, status"
      )
      .eq("user_id", user.id)
      .maybeSingle();

    if (dbError) {
      console.error("Deriv account lookup failed:", dbError.code);

      return NextResponse.json(
        { error: "Unable to check the saved connection." },
        { status: 500 }
      );
    }

    if (!connection || connection.status !== "connected") {
      return NextResponse.json(
        { error: "Deriv is not connected." },
        { status: 404 }
      );
    }

    if (
      connection.expires_at &&
      new Date(connection.expires_at).getTime() <= Date.now()
    ) {
      return NextResponse.json(
        { error: "Deriv authorization has expired. Please reconnect." },
        { status: 401 }
      );
    }

    // Decrypt the token on the server only.
    const accessToken = decryptToken(
      connection.encrypted_token,
      connection.token_iv,
      connection.token_tag
    );

    // Request the customer's Deriv trading accounts.
    const derivResponse = await fetch(
      "https://api.derivws.com/trading/v1/options/accounts",
      {
        method: "GET",
        headers: {
          Authorization: `Bearer ${accessToken}`,
          Accept: "application/json"
        },
        cache: "no-store"
      }
    );

    if (!derivResponse.ok) {
      console.error("Deriv account request failed:", {
        httpStatus: derivResponse.status
      });

      return NextResponse.json(
        {
          error:
            derivResponse.status === 401
              ? "Deriv authorization is invalid or expired. Please reconnect."
              : derivResponse.status === 403
              ? "Deriv denied access. Check the authorization permissions."
              : "Deriv could not return your account information."
        },
        { status: derivResponse.status }
      );
    }

    const result = await derivResponse.json();

    // Return account information, never the access token.
    return NextResponse.json(
      {
        success: true,
        accounts: result.data ?? []
      },
      {
        headers: {
          "Cache-Control": "no-store"
        }
      }
    );

  } catch (error) {
    console.error("Deriv account check failed:", {
      errorType:
        error instanceof Error ? error.name : "UnknownError"
    });

    return NextResponse.json(
      { error: "Unable to retrieve Deriv account information." },
      { status: 500 }
    );
  }
}
