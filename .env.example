# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Server-only secret. Never prefix this with NEXT_PUBLIC_ or expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY

# Optional, server-side SENFX OpenAI research explanation (disabled by default)
SENFX_OPENAI_RESEARCH_ENABLED=false
SENFX_OPENAI_MODEL=gpt-4.1-mini
# Set OPENAI_API_KEY only in the secure Vercel Preview environment; never commit the raw key.
