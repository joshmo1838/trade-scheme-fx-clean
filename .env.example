# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Server-only Supabase secret. Never prefix this with NEXT_PUBLIC_ or expose it in browser code.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SECRET-KEY

# Deriv OAuth 2.0. Register DERIV_REDIRECT_URI exactly in your Deriv OAuth application.
DERIV_CLIENT_ID=YOUR-DERIV-OAUTH-APP-ID
DERIV_REDIRECT_URI=https://www.tradesche.com/api/deriv/callback
DERIV_SITE_URL=https://www.tradesche.com
# Optional. Omit for Vercel preview hosts; production tradesche.com uses .tradesche.com.
# DERIV_COOKIE_DOMAIN=.tradesche.com

# Generate a random 32-byte key with: openssl rand -hex 32
# Store only as a server-side Vercel Secret. Never commit the real value.
DERIV_TOKEN_ENCRYPTION_KEY=64_HEX_CHARACTERS

# Keep OAuth disabled until the Deriv OAuth app, exact redirect URI, and scopes are approved/configured.
DERIV_OAUTH_ENABLED=false

# Keep Demo execution disabled until the Demo-only SQL migration and Preview environment are verified.
DERIV_DEMO_TRADING_ENABLED=false
