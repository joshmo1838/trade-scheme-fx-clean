FROM node:22-bookworm-slim
WORKDIR /app
COPY worker/quantum-ai/ ./worker/quantum-ai/
COPY tests/quantum-ai5.mjs ./tests/quantum-ai5.mjs
RUN node tests/quantum-ai5.mjs && node --check worker/quantum-ai/run.mjs && node --check worker/quantum-ai/deep-scan.mjs
USER node
CMD ["node", "worker/quantum-ai/run.mjs"]
