FROM node:22-bookworm-slim
WORKDIR /app
COPY worker/quantum-ai/ ./worker/quantum-ai/
COPY lib/quantum/strategy-catalog.mjs ./lib/quantum/strategy-catalog.mjs
COPY tests/quantum-ai5.mjs ./tests/quantum-ai5.mjs
COPY tests/live-4bot-feed.test.mjs ./tests/live-4bot-feed.test.mjs
RUN node tests/quantum-ai5.mjs && node --test tests/live-4bot-feed.test.mjs && node --check worker/quantum-ai/run.mjs && node --check worker/quantum-ai/deep-scan.mjs && node --check worker/quantum-ai/live-4bot-feed.mjs
USER node
CMD ["node", "worker/quantum-ai/run.mjs"]
